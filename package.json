{
  "name": "supertask",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "deploy:pages": "npm run frontend:generate && wrangler pages deploy ./frontend/dist --project-name=supertask-web",
    "build:pages": "node scripts/build-pages.mjs",
    "frontend:generate": "cd frontend && npm run generate",
    "frontend:dev": "cd frontend && npm run dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "audit:endpoints": "node scripts/audit-endpoints.mjs",
    "audit:baserow-parity": "node scripts/audit-baserow-parity.mjs",
    "audit:formula-parity": "vite-node scripts/audit-formula-parity.ts",
    "test:app": "SUPERTASK_EXPECT_SECURE_FILE_SERVE=1 node scripts/application-smoke-test.mjs",
    "test:builder-sso:production": "node scripts/builder-sso-production-smoke.mjs",
    "test:airtable:production": "node scripts/airtable-production-smoke.mjs",
    "test:data-sync:production": "node scripts/data-sync-production-smoke.mjs",
    "test:ui": "node scripts/frontend-smoke-test.mjs",
    "check": "npm run type-check && npm run audit:endpoints && npm run audit:baserow-parity && npm run audit:formula-parity",
    "type-check": "tsc --noEmit",
    "test": "vitest run tests/*.test.ts --maxWorkers=2",
    "test:frontend": "cd frontend && npm run test && npm run test:enterprise",
    "lint": "npm run audit:baserow-parity"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@hocuspocus/server": "4.4.0",
    "@hocuspocus/transformer": "4.4.0",
    "@node-saml/node-saml": "5.1.0",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "0.8.13",
    "antlr4ts": "^0.5.0-alpha.4",
    "bcryptjs": "^2.4.3",
    "fflate": "^0.8.3",
    "hono": "4.12.29",
    "jose": "^5.9.6",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "xpath": "0.0.34",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260710.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.14.1",
    "@types/pg": "^8.20.0",
    "playwright": "^1.61.1",
    "typescript": "5.8.3",
    "vitest": "3.2.6",
    "wrangler": "4.110.0",
    "xml-crypto": "6.1.2"
  }
}
